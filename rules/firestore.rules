rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return userDoc().role; }
    // Audit item 15: deactivated backend staff must lose access even though
    // soft-remove doesn't clear department (only teamId/tlId) — org.js's
    // remove flow now also clears department, but this checks active as a
    // second guard so a rules change alone is enough even if that ever drifts.
    // Single get() reused for both checks — no extra read over the old form.
    function isActiveBackend() {
      let u = userDoc();
      return u.department == 'backend' && u.active != false;
    }

    // ── MULTI-TENANCY (ARCHITECTURE.md Section 3) ─────
    // sameOrg(): for read/update/delete — compares the actor's orgId to the
    // EXISTING document's orgId (resource.data). sameOrgWrite(): for create
    // — compares the actor's orgId to the INCOMING document's orgId
    // (request.resource.data), since resource.data doesn't exist yet on a
    // create. Every collection below requires one of these on every clause,
    // per the audit's "a client cannot write into another org even with a
    // modified client" requirement — with one deliberate exception, see the
    // USERS self-registration comment below.
    //
    // Bootstrap safety: BEFORE the one-off orgId migration runs, NO document
    // has an orgId field at all. An earlier version of this function assumed
    // Firestore Rules treats a missing field as null on both sides, making
    // null == null evaluate true during the bootstrap window — that
    // assumption was wrong in practice and broke login for every account
    // (missing-field access did not behave as a safe null-comparison here).
    // Fixed with explicit 'in' existence checks instead of relying on
    // unverified comparison semantics: if either side hasn't been migrated
    // yet, allow the read/update so the app (and the migration itself) can
    // function during that window. Once every doc has orgId, this bootstrap
    // clause is permanently dormant. sameOrgWrite() only bypasses on the
    // ACTOR side (not the incoming data) since js/db.js's gateway always
    // stamps a real orgId on every create going forward — the incoming side
    // being unmigrated should not happen for any current app code path.
    function sameOrg() {
      return !('orgId' in userDoc()) || !('orgId' in resource.data) || userDoc().orgId == resource.data.orgId;
    }
    function sameOrgWrite() {
      return !('orgId' in userDoc()) || userDoc().orgId == request.resource.data.orgId;
    }

    // ── USERS ────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth() && sameOrg();
      allow create: if isAuth() && (
        // Self-registration bootstrap (first-ever login, ensureProfile() in
        // auth.js): deliberately NOT gated on sameOrgWrite() — userDoc()'s
        // get() would fail since the caller's own doc doesn't exist yet to
        // read an orgId from. Trusted because self-registration is closed
        // to the hardcoded SEED_EMAILS in state.js, not open signup — every
        // self-registering user gets their orgId from the same config.js
        // as everyone else in this single-tenant deployment.
        request.auth.uid == uid ||
        (role() == 'manager' && sameOrgWrite())
      );
      // Step 8 review fix: the old clause let a user update ANY field on
      // their own doc, including role/department/orgId/teamId — an agent
      // could self-write role:'manager' or department:'backend' and pass
      // every role()=='manager'/isActiveBackend() check in this whole file.
      // Manager stays unrestricted; self-write is now narrowed to exclude
      // every privileged/compensation-relevant/identity field. Traced
      // db.js's dbUpdate() to confirm the actual payload for a self-write
      // (e.g. the run-rate preference, js/dashboard.js) also carries
      // lastEditedBy/lastEditedAt (auditUpdate(), not in this blocklist),
      // so ordinary self-writes still pass with this narrower rule.
      allow update: if isAuth() && sameOrg() && (
        role() == 'manager' ||
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'role','department','orgId','teamId','tlId','active',
                'monthlyTarget','targetSource','autoTarget',
                'permissions','specialties','available','email',
                'createdBy','createdAt'
              ]))
      );
      allow delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── TEAMS ────────────────────────────────────────
    match /teams/{t} {
      allow read: if isAuth() && sameOrg();
      allow create: if isAuth() && role() == 'manager' && sameOrgWrite();
      allow update, delete: if isAuth() && role() == 'manager' && sameOrg();
      // Narrow exception: any authenticated user may update ONLY the
      // assignmentCursor field — needed because createSubmission() advances
      // the backend team's rotation cursor as part of the submitting agent's
      // own batch write, and that agent is not necessarily a manager.
      allow update: if isAuth() && sameOrg()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentCursor']);
    }

    // ── COMPANIES ────────────────────────────────────
    // Shared entity referenced by leads.companyId (see js/companies.js).
    // Read is open to all roles — every role's lead picker / backfill needs
    // to look companies up. Create follows the same createdBy-ownership
    // pattern as scripts/leads, so any authenticated user (agents included)
    // can add a new company via findOrCreateCompany() during lead entry.
    // Update/delete is manager-only for now — this will be relaxed via the
    // hasPermission() grant system once that lands (separate, not-yet-built
    // phase).
    match /companies/{c} {
      allow read: if isAuth() && sameOrg();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid && sameOrgWrite();
      allow update, delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── LEADS ────────────────────────────────────────
    match /leads/{l} {
      allow read: if isAuth() && sameOrg();

      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid && sameOrgWrite();

      // Manager: unrestricted
      allow update, delete: if isAuth() && role() == 'manager' && sameOrg();

      // Agent: update leads assigned to them, cannot touch ownership/admin fields
      allow update: if isAuth() && role() == 'agent' && sameOrg()
        && resource.data.assignedTo == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['assignedTo','assignedBy','ownerLocked','createdBy','createdByRole','teamId']);

      // Agent: delete only leads they personally created, and only if not manager-locked
      allow delete: if isAuth() && role() == 'agent' && sameOrg()
        && resource.data.createdBy == request.auth.uid
        && resource.data.ownerLocked != true;

      // Team lead: update leads within their team, cannot touch admin fields.
      // Uses teamId match for general visibility/edits (team-wide, per spec).
      // Sub-group (tlId) enforcement: if a write changes tlId (i.e. reassigns
      // the lead), the lead must currently be unowned or already theirs, and
      // must land back in their own sub-group. This closes the gap where one
      // TL could reassign a lead into or out of another TL's sub-group.
      allow update: if isAuth() && role() == 'team_lead' && sameOrg()
        && resource.data.teamId == userDoc().teamId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['ownerLocked','createdBy','createdByRole','teamId'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tlId'])
          || (
            (resource.data.tlId == request.auth.uid || resource.data.tlId == null || resource.data.tlId == '')
            && request.resource.data.tlId == request.auth.uid
          )
        );

      // Team lead: delete non-locked leads within their team (team-wide, per spec —
      // unchanged; delete was never reported as needing sub-group restriction)
      allow delete: if isAuth() && role() == 'team_lead' && sameOrg()
        && resource.data.teamId == userDoc().teamId
        && resource.data.ownerLocked != true;

      // Narrow exception, same pattern as teams.assignmentCursor above —
      // but scoped to BACKEND department staff only, not any authenticated
      // user: the pipeline badge (step 0d) is stamped by createSubmissions
      // (the submitting agent's own batch, already covered by the agent/TL
      // clauses above since submissionSummary isn't in either one's blocked-
      // fields list) AND by appendEvent, which is the only path with no
      // other clause covering it — a backend user acting on a submission
      // whose lead they don't own, aren't the TL of, and aren't a manager
      // for. Requiring isActiveBackend() here means an agent or TL can only
      // ever touch this field through their own already-scoped rule, never
      // through this exception.
      allow update: if isAuth() && sameOrg() && isActiveBackend()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissionSummary']);
    }

    // ── CHANNELS ─────────────────────────────────────
    match /channels/{c} {
      allow read: if isAuth() && sameOrg();
      allow create: if isAuth() && sameOrgWrite();
      allow update, delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── SCRIPTS ──────────────────────────────────────
    match /scripts/{s} {
      allow read: if isAuth() && sameOrg();

      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid && sameOrgWrite() && (
        role() == 'manager' ||
        (role() == 'team_lead' && request.resource.data.scope == 'team')
      );

      allow update, delete: if isAuth() && role() == 'manager' && sameOrg();

      allow update, delete: if isAuth() && role() == 'team_lead' && sameOrg()
        && resource.data.createdBy == request.auth.uid;

      allow update: if isAuth() && role() == 'team_lead' && sameOrg()
        && resource.data.createdBy != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingApproval'])
        && request.resource.data.pendingApproval != null
        && request.resource.data.pendingApproval.submittedBy == request.auth.uid;

      allow update: if isAuth() && role() == 'team_lead' && sameOrg()
        && resource.data.pendingApproval != null
        && resource.data.pendingApproval.submittedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingApproval'])
        && request.resource.data.pendingApproval == null;
    }

    // ── PRODUCTS ─────────────────────────────────────
    match /products/{p} {
      allow read: if isAuth() && sameOrg();
      allow create: if isAuth() && role() == 'manager' && sameOrgWrite();
      allow update, delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── ORGS (Session B4, ARCHITECTURE.md §3/§12) ───
    // Single per-deployment config doc, keyed by the org's own orgId — the
    // doc ID IS the identity, so this collection is authorized by KEY MATCH
    // (oid == userDoc().orgId) instead of sameOrg()/sameOrgWrite(). Step 8
    // review fix: those two helpers read resource.data.orgId /
    // request.resource.data.orgId, and while js/db.js's dbSet() gateway
    // actually does stamp an orgId FIELD onto every write today (so the
    // original sameOrgWrite()-based create wouldn't have errored in
    // practice), relying on that was fragile — a future edit to stop
    // stamping a redundant field (since the doc ID already carries the
    // identity) would silently break create with no warning. Key-matching
    // has no such dependency and needs no bootstrap-window guard: this is a
    // brand-new collection, so there's no pre-migration legacy data to
    // support, unlike sameOrg()'s 'orgId' in resource.data checks elsewhere
    // in this file.
    //
    // Read is open to every authenticated same-org user since
    // loadOrgConfig() runs for every role at login — category labels and
    // specialty checklists need it before first paint, not just for
    // managers. Write is split per-field: manager can touch anything on
    // this doc (categories, contractTermLabels, Step 3), team_lead is
    // narrowed to ONLY runRateDefaultVisible (Step 7's fixed decision),
    // same hasOnly() narrow-exception pattern as teams.assignmentCursor and
    // leads.submissionSummary above — a team_lead write that touches
    // categories or contractTermLabels alongside it is rejected outright,
    // not silently partially applied.
    //
    // Doc creation: no code path has created this doc yet (Step 2's
    // migration and Steps 3/7's saveOrgConfig() all attempt it but every
    // attempt so far predates these rules being published). First real
    // creation happens at the start of Step 9 (regression), by re-running
    // the Step 2 migration as manager — verified with a live getDoc()
    // immediately after, not assumed.
    match /orgs/{oid} {
      allow read: if isAuth() && oid == userDoc().orgId;
      allow create: if isAuth() && role() == 'manager' && oid == userDoc().orgId;
      allow update: if isAuth() && oid == userDoc().orgId && (
        role() == 'manager' ||
        (role() == 'team_lead'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['runRateDefaultVisible']))
      );
      allow delete: if isAuth() && role() == 'manager' && oid == userDoc().orgId;
    }

    // ── SUBMISSIONS ──────────────────────────────────
    // Agent → backend handoff. v2 schema (ARCHITECTURE.md §3/§5): one doc per
    // product line (bundleId links siblings), coarse status + events[]
    // timeline, replacing the old 5-fixed-stage items[] design. See
    // js/submissions.js.
    match /submissions/{s} {
      // Audit item 14: the teamId clause used to match ANY role on the same
      // team, letting fellow sales agents read each other's submissions
      // (and the ID-document paths within them) — violates
      // PHASE5_SPEC_AND_HANDOFF.md §5 (agent, their TL, backend, manager
      // ONLY). Now requires role()=='team_lead' too.
      allow read: if isAuth() && sameOrg() && (
        role() == 'manager' ||
        resource.data.agentId == request.auth.uid ||
        (role() == 'team_lead' && resource.data.teamId == userDoc().teamId) ||
        isActiveBackend()
      );

      // submittedBy dropped (v2 schema has no such field — agentId already
      // identifies the submitting agent; the 'created' event in events[]
      // carries the same actorId as an audit record).
      allow create: if isAuth() && sameOrgWrite()
        && request.resource.data.agentId == request.auth.uid;

      // Manager and active backend dept: unrestricted (status/events[]/
      // assignedBackendAgent all covered — will be narrowed once the backend
      // queue UI's actual update shape is known, not this session).
      //
      // Submitting agent's correction-loop (audit item 16, built now): may
      // update their OWN submission ONLY while it's status=='rejected', and
      // ONLY to move it back to 'pendingVerification' (append a 'resubmit'
      // event with the docs/fields fix) — cannot self-activate, cannot touch
      // any other status, cannot touch someone else's submission.
      allow update: if isAuth() && sameOrg() && (
        role() == 'manager' ||
        isActiveBackend() ||
        (resource.data.agentId == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pendingVerification')
      );

      // Manager-only, deliberately narrow: no delete for backend/agent, even
      // the submitting agent — order records stay in the system for review
      // (e.g. a suspected-fake document upload) rather than being quietly
      // removable by whoever created them. Matches the delete pattern
      // already used for leads/companies/teams/scripts/products.
      allow delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── SUBMISSION DOCS (ARCHITECTURE.md §6) ────────
    // firestore-b64 storage driver: one doc per PAGE, keyed by bundleId (not
    // submission id) since company documents attach once per bundle, shared
    // across every product-line submission in it. agentId/teamId are
    // denormalized copies of the owning submission's own fields (stamped by
    // js/storage/firestore-b64.js's put()), so the read rule mirrors the
    // submissions read rule exactly — same four parties, same reasoning.
    match /submissionDocs/{d} {
      allow read: if isAuth() && sameOrg() && (
        role() == 'manager' ||
        resource.data.agentId == request.auth.uid ||
        (role() == 'team_lead' && resource.data.teamId == userDoc().teamId) ||
        isActiveBackend()
      );

      // Uploaded at Submit-to-Backend time by the submitting agent, at
      // Fix & Resubmit time (also the submitting agent — a new version is a
      // CREATE, never an edit), by a manager, or by backend department
      // staff ATTACHING an additional document to someone else's bundle
      // (step 5b) — that page's agentId is deliberately the ORIGINAL
      // agent's own uid, not the backend uploader's, so the read rule's
      // agentId/teamId clauses keep working for the agent and their TL;
      // isActiveBackend() is what actually authorizes the backend upload
      // itself, since request.resource.data.agentId won't equal a backend
      // uploader's own uid.
      allow create: if isAuth() && sameOrgWrite()
        && (request.resource.data.agentId == request.auth.uid || role() == 'manager' || isActiveBackend());

      // Pages are immutable — replacing a document means delete + re-upload,
      // never an in-place edit, so there is no update rule at all.
      allow update: if false;

      // Manager-only, matching the retention sweep's own manager-only gate
      // (js/org.js runDocumentRetentionSweep) — no one else can bulk- or
      // single-delete stored pages, including the uploading agent.
      allow delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── ROLLUPS (Phase C, ARCHITECTURE.md §15) ──────
    // Per-month rollup counter docs, id = 'YYYY-MM' (a FIELD-orgId collection
    // like submissions — orgId is stamped on every write by
    // js/rollups.js applyRollupDeltas() and the recompute tool's dbSet() — NOT
    // a key-matched collection like orgs/, so sameOrg()/sameOrgWrite() apply
    // exactly as they do for submissions).
    //
    // Write-time increments ride BOTH an agent's submission-create batch
    // (SITE 1) AND a backend user's activation transaction (SITES 2-5), plus
    // the manager-only recompute overwrite (SITE 6 delete rides deleteSubmission
    // too). create/update therefore CANNOT be narrowed to a single role without
    // breaking either the agent create path or the backend activation path — so
    // any same-org authed user may create/update, and CLIENT-TRUST on the
    // counter values is an explicitly documented tradeoff (§15.5) reserved for
    // the later security overhaul (the recompute tool is the correction path if
    // a client ever writes a bad value). Read: any same-org user
    // (getDashboardData's preset reads + the recompute dry-run), all single-doc
    // getDoc by key — the collection is NEVER list-queried, so no
    // resource.data-provability concern and no composite index. Delete:
    // manager-only, matching every other collection.
    match /rollups/{m} {
      allow read:   if isAuth() && sameOrg();
      allow create: if isAuth() && sameOrgWrite();
      allow update: if isAuth() && sameOrg();
      allow delete: if isAuth() && role() == 'manager' && sameOrg();
    }

    // ── SOF TEMPLATES (Session S1, ARCHITECTURE.md §17) ──
    // Blank Service Order Forms managers upload for every role to download
    // (latest version only) — RAW original file bytes, base64-chunked, one
    // parent doc per uploaded VERSION + a `chunks` subcollection holding the
    // actual base64 data. Field-orgId collection (orgId stamped on every
    // write, like submissions/rollups), NOT key-matched like orgs/.
    //
    // Read: manager -> any; every other role -> ONLY the CURRENT LATEST
    // version (resource.data.isLatest == true). This is the mirror-image of
    // the LIST-query provability pattern already established elsewhere in
    // this file (a non-manager role's query must match its own OR-clause's
    // resource.data condition exactly to be provable) — here the condition
    // isn't a role-scoping field like teamId/agentId, it's the SAME
    // isLatest field js/sofTemplates.js's fetchLatestForms() already
    // filters on (where('isLatest','==',true)), so that query is provable
    // for every role without any composite index.
    //
    // Write: manager only, full stop — no agent/team_lead/backend create,
    // update, or delete path exists for this collection at all (unlike
    // submissions' agent-self-resubmit exception, there is no analogous
    // non-manager mutation here).
    match /sofTemplates/{id} {
      allow read: if isAuth() && sameOrg() && (
        role() == 'manager' || resource.data.isLatest == true
      );
      allow create: if isAuth() && role() == 'manager' && sameOrgWrite();
      allow update: if isAuth() && role() == 'manager' && sameOrg();
      allow delete: if isAuth() && role() == 'manager' && sameOrg();

      // ── CHUNKS — the LOAD-BEARING gate, not the parent's ──
      // A chunk get() is a DIRECT read by known id (js/sofTemplates.js
      // downloadSofTemplate: chunk-0..chunk-(chunkCount-1)), never a list
      // query — it does NOT re-read or re-check the parent doc as part of
      // being evaluated. isLatest is therefore DENORMALIZED onto every
      // chunk (stamped at upload time and flipped false in the SAME batch
      // that supersedes a version) specifically so this rule has its own
      // resource.data to gate on. If this isLatest condition were ever
      // missing here, any authenticated non-manager user who obtained (by
      // any means) a superseded version's parent id could still
      // reassemble its full byte content chunk-by-chunk — even though
      // that version never appears in any listing they can run — since
      // the PARENT rule above is never consulted during a chunk read.
      match /chunks/{n} {
        allow read: if isAuth() && sameOrg() && (
          role() == 'manager' || resource.data.isLatest == true
        );
        allow create: if isAuth() && role() == 'manager' && sameOrgWrite();
        allow update: if isAuth() && role() == 'manager' && sameOrg();
        allow delete: if isAuth() && role() == 'manager' && sameOrg();
      }
    }

    // ── AUDIT LOG (ARCHITECTURE.md §3) ──────────────
    // Append-only: js/db.js writes one doc per mutation, in the same batch
    // as the mutation itself. No update/delete ever — the log is only ever
    // added to. Read is manager-only; no UI consumes this yet, but that's
    // exactly why it shouldn't be readable by the same users whose actions
    // it records.
    match /auditLog/{a} {
      allow read: if isAuth() && role() == 'manager' && sameOrg();
      allow create: if isAuth() && sameOrgWrite();
      allow update, delete: if false;
    }
  }
}
